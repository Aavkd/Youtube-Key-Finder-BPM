# ─────────────────────────────────────────────────────────────
# Key Finder — environment variables
# Copy this file to `.env` and adjust values for your environment.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string used by backend + worker.
# Host `db` is the service name on the compose network.
DATABASE_URL=postgresql+asyncpg://keyfinder:keyfinder@db:5432/keyfinder

# Raw Postgres credentials consumed by the official `postgres` image.
# In production: use a strong random password (never commit the real value).
POSTGRES_USER=keyfinder
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=keyfinder

# Path (inside the containers) to the shared audio storage volume.
AUDIO_STORAGE_PATH=/data/audio

# Reject videos longer than this (seconds). Default 1200 = 20 min.
MAX_DURATION_SECONDS=1200

# Number of parallel jobs the worker will process. Default 2.
QUEUE_CONCURRENCY=2

# YouTube Data API key — BACKEND ONLY, used by Discovery.
# Never expose this to the frontend / client.
YOUTUBE_API_KEY=

# Base URL the frontend uses to reach the backend API (browser-facing).
# In production: https://api.keyfinder.arpent.online
NEXT_PUBLIC_API_BASE_URL=http://localhost:8002

# ── Production auth ──────────────────────────────────────────
# Shared application token protecting the entire API.
# Empty = auth disabled (local dev only).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_AUTH_TOKEN=

# CORS allowed origins (comma-separated). Use "*" for local dev.
# In production: set to your exact Vercel URL.
CORS_ALLOW_ORIGINS=*

# Optional regex covering Vercel preview deploys.
# Example: https://.*\.vercel\.app
CORS_ALLOW_ORIGIN_REGEX=
